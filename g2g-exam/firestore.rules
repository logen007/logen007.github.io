rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && me().active != false; }
    function isMaster() { return activeUser() && me().role == 'master'; }
    function isTeacher() { return activeUser() && (me().role == 'teacher' || me().role == 'master'); }
    function settingsExist() { return exists(/databases/$(database)/documents/settings/global); }
    function globalSettings() { return get(/databases/$(database)/documents/settings/global).data; }
    function signupEnabled() {
      return !settingsExist()
        || (globalSettings().auth.googleLoginEnabled == true && globalSettings().auth.allowNewStudents == true);
    }
    function signupDomainAllowed() {
      return !settingsExist()
        || globalSettings().auth.allowedDomain == ''
        || request.auth.token.email.matches('.*@' + globalSettings().auth.allowedDomain + '$');
    }
    function answerWindowOpen() {
      return resource.data.currentDeadlineMs == 0
        || request.time.toMillis() <= resource.data.currentDeadlineMs + 3000;
    }
    function onlyCurrentSectionAnswersChanged() {
      return request.resource.data.answers.diff(resource.data.answers)
        .affectedKeys().hasOnly(resource.data.currentQuestionIds);
    }

    match /publicSettings/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.role == 'student'
        && request.resource.data.active == true
        && signupEnabled()
        && signupDomainAllowed();
      allow read: if signedIn() && (uid == request.auth.uid || isTeacher());
      allow update, delete: if isMaster();
    }

    match /settings/{id} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /questions/{id} {
      allow read: if isTeacher();
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMaster() || (
        isTeacher()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.locked != true
      );
      allow delete: if isMaster();
    }

    match /questionPublic/{id} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /exams/{id} {
      allow read: if isTeacher() || (activeUser() && resource.data.status == 'published');
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMaster() || (
        isTeacher()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          resource.data.locked != true
          || (
            request.resource.data.status == 'trash'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deletedAt','updatedAt'])
          )
        )
      );
      allow delete: if isMaster();
    }

    match /gradingRequests/{id} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.ownerId == request.resource.data.ownerId;
      allow update: if isMaster() || (
        isTeacher()
        && get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.ownerId == request.auth.uid
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isMaster();
    }

    match /attempts/{id} {
      allow read: if isTeacher() || (activeUser() && resource.data.studentId == request.auth.uid);
      allow create: if false;
      // Học viên chỉ được autosave đáp án của phần đang làm, trong thời gian phần đó còn hiệu lực.
      // Mọi thay đổi trạng thái/timer/điểm đều phải đi qua Cloud Functions.
      allow update: if activeUser()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.status == 'in_progress'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.attemptNo == resource.data.attemptNo
        && request.resource.data.currentSectionIndex == resource.data.currentSectionIndex
        && request.resource.data.currentSectionId == resource.data.currentSectionId
        && request.resource.data.currentDeadlineMs == resource.data.currentDeadlineMs
        && request.resource.data.currentQuestionIds == resource.data.currentQuestionIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','updatedAt'])
        && onlyCurrentSectionAnswersChanged()
        && answerWindowOpen();
      allow delete: if false;
    }

    match /attemptPrivate/{id} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if isTeacher() || (activeUser() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /mail/{id} {
      allow read, write: if false;
    }
  }
}

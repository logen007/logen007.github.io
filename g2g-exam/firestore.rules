rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMaster() { return signedIn() && me().role == 'master' && me().active != false; }
    function isTeacher() { return signedIn() && (me().role == 'teacher' || me().role == 'master') && me().active != false; }
    function isOwner(resourceData) { return signedIn() && resourceData.ownerId == request.auth.uid; }
    function gradingApproved(examId) {
      return signedIn() && exists(/databases/$(database)/documents/gradingRequests/$(examId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/gradingRequests/$(examId + '_' + request.auth.uid)).data.status == 'approved';
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student';
      allow read: if signedIn();
      allow update, delete: if isMaster();
    }

    match /questions/{id} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isMaster() || (isTeacher() && resource.data.ownerId == request.auth.uid);
    }

    match /exams/{id} {
      allow read: if signedIn() && (resource.data.status == 'published' || isTeacher());
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isMaster() || (isTeacher() && resource.data.ownerId == request.auth.uid);
    }

    match /gradingRequests/{id} {
      allow read: if isTeacher();
      allow create: if isTeacher() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isMaster()
        || get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.ownerId == request.auth.uid;
      allow delete: if isMaster();
    }

    // Lượt thi chứa điểm và trạng thái nhạy cảm. Ở production nên ghi điểm/công bố
    // qua Cloud Functions/Admin SDK. Client chỉ được đọc lượt của mình hoặc giáo viên có quyền.
    match /attempts/{id} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || isMaster()
        || (isTeacher() && (
          get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.ownerId == request.auth.uid
          || gradingApproved(resource.data.examId)
        ))
      );
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.totalScore == null;
      allow update: if signedIn() && resource.data.studentId == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.totalScore == resource.data.totalScore
        && request.resource.data.autoScore == resource.data.autoScore
        && request.resource.data.manualScores == resource.data.manualScores
        && request.resource.data.result == resource.data.result
        && request.resource.data.status == 'in_progress';
      allow delete: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isMaster());
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /mail/{id} {
      allow read, write: if false;
    }
  }
}

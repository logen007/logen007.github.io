rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMaster() { return signedIn() && me().role == 'master' && me().active != false; }
    function isTeacher() { return signedIn() && (me().role == 'teacher' || me().role == 'master') && me().active != false; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student';
      allow read: if signedIn();
      allow update, delete: if isMaster();
    }

    match /questions/{id} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isMaster() || (isTeacher() && resource.data.ownerId == request.auth.uid);
    }

    match /exams/{id} {
      allow read: if signedIn() && (resource.data.status == 'published' || isTeacher());
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isMaster() || (isTeacher() && resource.data.ownerId == request.auth.uid);
    }

    match /gradingRequests/{id} {
      allow read: if isTeacher();
      allow create: if isTeacher() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isMaster()
        || get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.ownerId == request.auth.uid;
      allow delete: if isMaster();
    }

    // Điểm và trạng thái nộp/công bố là dữ liệu tin cậy phía server.
    // Học viên chỉ được tạo lượt đang làm và cập nhật câu trả lời khi lượt vẫn đang làm.
    // Nộp bài, chấm điểm và công bố kết quả phải đi qua Cloud Functions/Admin SDK.
    match /attempts/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.totalScore == null
        && request.resource.data.autoScore == 0;
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.status == 'in_progress'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.autoScore == resource.data.autoScore
        && request.resource.data.manualScores == resource.data.manualScores
        && request.resource.data.sectionScores == resource.data.sectionScores
        && request.resource.data.totalScore == resource.data.totalScore
        && request.resource.data.result == resource.data.result
        && request.resource.data.reviewerId == resource.data.reviewerId
        && request.resource.data.publishedAt == resource.data.publishedAt;
      allow delete: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isMaster());
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
